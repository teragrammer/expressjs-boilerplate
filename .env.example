NODE_ENV=development
PORT=4000
PORT_EXPOSE=4000
HAS_PROXY=false

# Comma-separated list of allowed CORS origins. 
# In production, this MUST be explicitly set (no wildcard).
# Example: https://app.example.com,https://admin.example.com
CORS_ORIGINS=http://localhost:3000,http://localhost:4000,http://127.0.0.1:3000,http://127.0.0.1:4000

CLUSTER=false
# CLUSTER_WORKERS defaults to CPU count if not set

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=express_api
DB_CHARSET=utf8
DB_DATE_STRING=false
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_SSL=false
DB_SSL_CA=
DB_SSL_CERT=
DB_SSL_KEY=
DB_SSL_REJECT_UNAUTHORIZED=true

# Optional: connection string used by the Postgres MCP server
DATABASE_URL=

REDIS_HOST=
REDIS_PORT=6379
REDIS_PASS=
REDIS_TLS=false
REDIS_TLS_CA=
REDIS_TLS_CERT=
REDIS_TLS_KEY=

SENDGRID_API_KEY=

JWT_TFA=false
# JWT_SECRET must be at least 32 characters for HS256
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRATION_DAYS=7

BCRYPT_SALT_ROUND=12
# BCRYPT_SECRET must be at least 32 characters
BCRYPT_SECRET=your-bcrypt-pepper-change-in-production-min-32-chars

# CRYPT0_SECRET must be exactly 32 bytes (64 hex chars) for AES-256-GCM
CRYPT0_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
CRYPT0_CIPHER=aes-256-gcm
CRYPTO_IV=12