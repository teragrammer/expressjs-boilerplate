# NODE_ENV must be set explicitly. `production` enables fail-closed
# validation, secure cookies and strict TLS verification.
NODE_ENV=development
PORT=4000
PORT_EXPOSE=4000
# Enable only when the application is behind a trusted reverse proxy.
HAS_PROXY=false

# Comma-separated list of allowed CORS origins.
# In production, this MUST be explicitly set (no wildcard).
# Example: https://app.example.com,https://admin.example.com
CORS_ORIGINS=http://localhost:3000,http://localhost:4000,http://127.0.0.1:3000,http://127.0.0.1:4000

CLUSTER=false
# Worker count when CLUSTER=true.
# Empty or unset: defaults to the CPU count. Positive integer otherwise.
CLUSTER_WORKERS=

# Only PostgreSQL is supported. Kept explicit so the configuration
# surface matches the environment schema.
DB_CLIENT=pg
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=express_api
# Retained for compatibility; PostgreSQL does not use these values.
DB_CHARSET=utf8
DB_DATE_STRING=false
DB_POOL_MIN=2
DB_POOL_MAX=10
# Total connection budget across all workers of this process.
# Boot fails if DB_POOL_MAX x workers (plus reserve) exceeds it.
DB_MAX_CONNECTIONS_TOTAL=100
DB_SSL=false
# Empty DB_SSL_CA uses the system trust store. In production,
# DB_SSL_REJECT_UNAUTHORIZED must be true whenever DB_SSL is enabled.
DB_SSL_CA=
# Optional client certificate/key for mutual TLS. Set both or neither.
# Paths must be readable at runtime (mount secrets; do not bake them in).
DB_SSL_CERT=
DB_SSL_KEY=
DB_SSL_REJECT_UNAUTHORIZED=true
# Server-side timeouts that protect the connection pool.
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000

# Optional: connection string used by the Postgres MCP server only.
# The API ignores this value. Use sslmode=verify-full with a trusted CA;
# sslmode=no-verify is rejected by the MCP helper.
DATABASE_URL=

REDIS_HOST=
REDIS_PORT=6379
REDIS_PASS=
REDIS_TLS=false
# Empty REDIS_TLS_CA uses the system trust store. Redis certificates
# are always verified, in every environment.
REDIS_TLS_CA=
# Optional client certificate/key. Set both or neither.
# Paths must be readable at runtime (mount secrets; do not bake them in).
REDIS_TLS_CERT=
REDIS_TLS_KEY=
# Optional name to verify against the server certificate when REDIS_HOST
# is an address the certificate does not cover (for example, connecting
# by IP to a certificate whose SAN/CN is a hostname).
REDIS_TLS_SERVERNAME=

# Email delivery.
# EMAIL_ENABLED must be true (the default) for password recovery,
# verification and TFA to work. Production requires both a SendGrid key
# and a valid sender address when email is enabled.
EMAIL_ENABLED=true
SENDGRID_API_KEY=
# Fallback sender address when a setting does not define one.
MAIL_FROM_ADDRESS=

# JWT_SECRET must be at least 32 characters. The placeholder below is
# rejected in production; generate a unique value, e.g.
# openssl rand -base64 48.
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
# Access token lifetime in minutes (short-lived by design).
JWT_ACCESS_TOKEN_MINUTES=15
# Refresh token and session lifetime in days.
JWT_REFRESH_TOKEN_DAYS=7
JWT_ISSUER=express-api
JWT_AUDIENCE=express-api-client

BCRYPT_SALT_ROUND=12
# BCRYPT_SECRET must be at least 32 characters. The placeholder below is
# rejected in production.
BCRYPT_SECRET=your-bcrypt-pepper-change-in-production-min-32-chars

# CRYPT0_SECRET must be at least 32 characters. A 32-byte AES-256-GCM
# key is derived from it with HKDF-SHA-256. The placeholder below is
# rejected in production.
CRYPT0_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
CRYPT0_CIPHER=aes-256-gcm

# Observability.
LOG_LEVEL=info
# The metrics endpoint is unauthenticated; restrict it at the network layer.
METRICS_ENABLED=true
METRICS_PATH=/metrics

# Audit trail.
AUDIT_ENABLED=true

# Background jobs.
OUTBOX_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=25
CLEANUP_INTERVAL_MS=900000

# Password for the seeded development accounts.
# Required to run the seeder; it is never generated or logged.
# Seeding is refused in production. Set a unique value of at least
# 12 characters before running `npm run db:seed`.
SEED_PASSWORD=
