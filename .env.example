NODE_ENV=development
PORT=4000
PORT_EXPOSE=4000
HAS_PROXY=false

# Comma-separated list of allowed CORS origins.
# In production, this MUST be explicitly set (no wildcard).
# Example: https://app.example.com,https://admin.example.com
CORS_ORIGINS=http://localhost:3000,http://localhost:4000,http://127.0.0.1:3000,http://127.0.0.1:4000

CLUSTER=false
# CLUSTER_WORKERS defaults to the CPU count if not set.

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=express_api
DB_CHARSET=utf8
DB_DATE_STRING=false
DB_POOL_MIN=2
DB_POOL_MAX=10
# Total connection budget across all workers of this process.
# The application warns when DB_POOL_MAX x workers exceeds it.
DB_MAX_CONNECTIONS_TOTAL=100
DB_SSL=false
DB_SSL_CA=
DB_SSL_CERT=
DB_SSL_KEY=
DB_SSL_REJECT_UNAUTHORIZED=true
# Server-side timeouts that protect the connection pool.
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000

# Optional: connection string used by the Postgres MCP server
DATABASE_URL=

REDIS_HOST=
REDIS_PORT=6379
REDIS_PASS=
REDIS_TLS=false
REDIS_TLS_CA=
REDIS_TLS_CERT=
REDIS_TLS_KEY=

# Email delivery.
# EMAIL_ENABLED must be true (the default) for password recovery,
# verification and TFA to work.
EMAIL_ENABLED=true
SENDGRID_API_KEY=
# Fallback sender address when a setting does not define one.
MAIL_FROM_ADDRESS=

# JWT_SECRET must be at least 32 characters.
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
# Access token lifetime in minutes (short-lived by design).
JWT_ACCESS_TOKEN_MINUTES=15
# Refresh token and session lifetime in days.
JWT_REFRESH_TOKEN_DAYS=7
JWT_ISSUER=express-api
JWT_AUDIENCE=express-api-client

BCRYPT_SALT_ROUND=12
# BCRYPT_SECRET must be at least 32 characters.
BCRYPT_SECRET=your-bcrypt-pepper-change-in-production-min-32-chars

# CRYPT0_SECRET must be at least 32 characters. A 32-byte AES-256-GCM
# key is derived from it with HKDF-SHA-256.
CRYPT0_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
CRYPT0_CIPHER=aes-256-gcm

# Observability.
LOG_LEVEL=info
METRICS_ENABLED=true
METRICS_PATH=/metrics

# Audit trail.
AUDIT_ENABLED=true

# Background jobs.
OUTBOX_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=25
CLEANUP_INTERVAL_MS=900000

# Password for the seeded development accounts.
# When unset, a random password is generated and logged once.
SEED_PASSWORD=
