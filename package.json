{
  "name": "expressjs-boilerplate",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon",
    "build": "rimraf dist && tsc",
    "start": "node dist/src/index.js",
    "test": "vitest --no-file-parallelism",
    "test:run": "vitest run --no-file-parallelism",
    "setup": "npm run setup:skills",
    "setup:skills": "npx skills experimental_install",
    "setup:check": "npx skills experimental_install --dry-run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test:coverage": "vitest run --no-file-parallelism --coverage",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "openapi:lint": "ts-node scripts/openapi-lint.ts",
    "db:migrate": "ts-node scripts/db/migrate.ts",
    "db:seed": "ts-node scripts/db/seed.ts",
    "db:reset": "npm run db:migrate && npm run db:seed",
    "make:migration": "ts-node scripts/db/make-migration.ts",
    "make:seed": "ts-node scripts/db/make-seed.ts",
    "load:test": "bash tests/load/run.sh",
    "load:test:smoke": "bash tests/load/run.sh smoke",
    "load:test:stress": "bash tests/load/run.sh stress",
    "load:test:soak": "bash tests/load/run.sh soak",
    "prepare": "node scripts/setup-skills.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prometheus-io/client": "^0.16.1",
    "@sendgrid/mail": "^8.1.6",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-useragent": "^2.2.3",
    "google-libphonenumber": "^3.2.48",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "ioredis": "^6.0.0",
    "joi": "^18.3.2",
    "jsonwebtoken": "^9.0.3",
    "kysely": "0.29.8",
    "luxon": "^3.7.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "xss": "^1.0.17"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-useragent": "^1.0.5",
    "@types/google-libphonenumber": "^7.4.31",
    "@types/hpp": "^0.2.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitest/coverage-v8": "^5.1.0",
    "artillery": "^2.0.34",
    "eslint": "^10.14.0",
    "globals": "^15.15.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
